# The service worker must never be cached, or a deploy is invisible until the
# old worker happens to expire.
/sw.js
  Cache-Control: no-cache, max-age=0

# Hashed assets never change under a given URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts are content-addressed by name and change only when replaced.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The opening history is fetched once on first run; let a redeploy replace it.
/history.json
  Cache-Control: no-cache, max-age=0
